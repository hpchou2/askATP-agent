  "cards": [
    {
      "dot": "cyan",
      "title": "Why two calls",
      "items": [
        "interrupt() stops the run and saves it",
        "The first HTTP call returns the proposal and ends",
        "The approve call loads the run and continues it"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety checks",
      "items": [
        "No PO changes before a planner decides",
        "If the data changed, the approval is refused as stale",
        "Approved, rejected and stale decisions are logged"
      ]
