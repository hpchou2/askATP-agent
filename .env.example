# Copy this file to .env and fill in your Anthropic credentials before running the API.

# Anthropic API key — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model to use — defaults to claude-sonnet-4-6 if omitted
# Available options: claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6
